---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Manos for Homes — Building Dreams',
	description = 'Manos for Homes is a non-profit foundation building homes and serving impoverished communities in Colombia and the USA.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/hand.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/logo-full.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--blue: #1786f0;
		--blue-dark: #0e5cad;
		--blue-deep: #0a4685;
		--red: #c81f44;
		--yellow: #f9be6a;
		--yellow-bright: #f5a93d;
		--sky: #c9e8fb;
		--paper: #f7fbff;
		--ink: #1a2b3c;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Nunito', system-ui, sans-serif;
		color: var(--ink);
		background: var(--paper);
		line-height: 1.6;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: 'Baloo 2', 'Nunito', system-ui, sans-serif;
		line-height: 1.15;
	}

	img {
		max-width: 100%;
		display: block;
	}

	a {
		color: var(--blue);
	}
</style>
