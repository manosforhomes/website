---
import Layout from '../layouts/Layout.astro';

const instagram = 'https://www.instagram.com/project_manosforhomes/';

const icons = {
	home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
	heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
	globe: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
};

const pillars = [
	{
		icon: icons.home,
		title: 'Building Homes',
		text: 'We build safe, dignified homes for impoverished families in Colombia — turning empty lots into places families can call their own.',
	},
	{
		icon: icons.heart,
		title: 'Community Service',
		text: 'From holiday celebrations to community events, we show up for the people we serve — in Colombia and in the United States.',
	},
	{
		icon: icons.globe,
		title: 'Partnerships',
		text: 'We work with companies and fellow foundations — like the Sereniti Foundation — in the USA and Colombia to multiply our impact.',
	},
];

---

<Layout>
	<header class="site-header">
		<nav class="container nav">
			<a href="#top" class="brand">
				<img src="/hand.png" alt="Manos for Homes hand logo" width="44" height="46" />
				<span>Manos <em>for</em> Homes</span>
			</a>
			<div class="nav-links">
				<a href="/who-we-are">Who We Are</a>
				<a href="#work">What We Do</a>
				<a href="#homes">Our Work</a>
				<a href="#involved">Get Involved</a>
				<a href={instagram} target="_blank" rel="noopener" class="btn btn-yellow btn-small">Follow Us</a>
			</div>
		</nav>
	</header>

	<main id="top">
		<!-- Hero -->
		<section class="hero">
			<div class="container hero-inner">
				<h1>Manos for Homes</h1>
				<p class="tagline">Building Dreams</p>
				<p class="hero-text">
					A non-profit foundation serving communities in the United States and Colombia — building
					homes for families in need and bringing neighbors together, one pair of hands at a time.
				</p>
				<div class="hero-actions">
					<a href="#involved" class="btn btn-yellow">Get Involved</a>
					<a href={instagram} target="_blank" rel="noopener" class="btn btn-outline">Follow Our Journey</a>
				</div>
			</div>
			<svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0,50 C240,90 480,10 720,40 C960,70 1200,20 1440,55 L1440,90 L0,90 Z" fill="var(--paper)" />
			</svg>
		</section>

		<!-- Mission -->
		<section id="mission" class="section">
			<div class="container narrow">
				<p class="eyebrow">Our Mission</p>
				<h2>Every family deserves a place to call home.</h2>
				<p class="lead">
					Manos for Homes — <em>manos</em> means <strong>hands</strong> in Spanish — was founded by
					Simon Aljure-Jauregui with a simple belief: when a community lends its hands, families rise.
					We serve impoverished communities in both the United States and Colombia — building homes
					for families in need, organizing community events, and partnering with companies and
					foundations in both countries.
				</p>
			</div>
		</section>

		<!-- What we do -->
		<section id="work" class="section section-sky">
			<div class="container">
				<p class="eyebrow">What We Do</p>
				<h2>Hands at work</h2>
				<div class="cards">
					{
						pillars.map((p) => (
							<article class="card">
								<div class="card-icon">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
								</div>
								<h3>{p.title}</h3>
								<p>{p.text}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- Our work: Colombia -->
		<section id="homes" class="section">
			<div class="container">
				<p class="eyebrow">In Colombia</p>
				<h2>We build homes</h2>
				<p class="section-intro">
					Alongside local families and partner foundations, we build safe, dignified homes for
					families in need — and we keep building. Every home is raised hand in hand with the
					community that will live in it.
				</p>
				<div class="gallery">
					<img src="/photos/roof-team.jpg" alt="Two volunteers securing a corrugated roof with mountains in the background" loading="lazy" />
					<img src="/photos/hands-together.jpg" alt="An adult and a young volunteer hammering together during a build" loading="lazy" />
					<img src="/photos/team-beam.jpg" alt="Volunteers working together on a structural beam" loading="lazy" />
					<img src="/photos/build-hammer.jpg" alt="A volunteer hammering during construction of a home" loading="lazy" />
				</div>
				<p class="homes-note">
					Follow every build from foundation to finished home on <a href={instagram} target="_blank" rel="noopener">our Instagram</a>.
				</p>
			</div>
		</section>

		<!-- Our work: Miami -->
		<section id="miami" class="section section-sky">
			<div class="container">
				<p class="eyebrow">In Miami</p>
				<h2>We build community</h2>
				<p class="section-intro">
					Our work starts at home in Miami. We organize community events, holiday celebrations, and
					fundraisers with local volunteers and partner organizations — bringing neighbors together
					and powering our work abroad.
				</p>
				<div class="gallery miami-gallery">
					<img src="/photos/miami-gifts.jpg" alt="Volunteers handing out wrapped gifts to children at a Miami community event" loading="lazy" />
					<img src="/photos/miami-food.jpg" alt="Volunteers serving food at a Manos for Homes community event in Miami" loading="lazy" />
					<img src="/photos/miami-kids.jpg" alt="Two smiling kids wearing red clown noses at a Miami community event" loading="lazy" />
				</div>
				<p class="homes-note">
					See our latest events on <a href={instagram} target="_blank" rel="noopener">Instagram</a>.
				</p>
			</div>
		</section>

		<!-- Partners -->
		<section class="section section-blue">
			<div class="container narrow center">
				<p class="eyebrow light">Partners</p>
				<h2>Stronger together</h2>
				<p class="lead">
					We are proud to work alongside companies and foundations in the United States and Colombia,
					including the <strong>Sereniti Foundation</strong>. If your organization wants to help
					families build a better future, we'd love to join hands with you.
				</p>
			</div>
		</section>

		<!-- Get involved -->
		<section id="involved" class="section">
			<div class="container narrow center">
				<p class="eyebrow">Get Involved</p>
				<h2>Lend a hand</h2>
				<p class="lead">
					Whether you want to volunteer, partner with us, or support our next build, reach out — every
					pair of hands makes a difference.
				</p>
				<div class="hero-actions">
					<a href={instagram} target="_blank" rel="noopener" class="btn btn-blue">Message us on Instagram</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-inner">
			<img src="/hand.png" alt="" width="40" height="42" />
			<p>
				<strong>Manos for Homes</strong> · Building Dreams<br />
				Serving communities in Colombia and the USA
			</p>
			<a href={instagram} target="_blank" rel="noopener">@project_manosforhomes</a>
		</div>
	</footer>
</Layout>

<style>
	.container {
		width: min(1080px, 92%);
		margin-inline: auto;
	}

	.narrow {
		max-width: 720px;
	}

	.center {
		text-align: center;
	}

	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--blue);
		box-shadow: 0 2px 12px rgba(10, 70, 133, 0.25);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.6rem;
		flex-wrap: wrap;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: #fff;
		font-family: 'Baloo 2', sans-serif;
		font-weight: 800;
		font-size: 1.25rem;
	}

	.brand em {
		color: var(--yellow);
		font-style: normal;
	}

	.brand img {
		border-radius: 10px;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.nav-links > a:not(.btn) {
		color: #eaf5fe;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
	}

	.nav-links > a:not(.btn):hover {
		color: var(--yellow);
	}

	/* Buttons */
	.btn {
		display: inline-block;
		font-family: 'Baloo 2', sans-serif;
		font-weight: 700;
		text-decoration: none;
		padding: 0.65rem 1.5rem;
		border-radius: 999px;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(10, 70, 133, 0.25);
	}

	.btn-small {
		padding: 0.4rem 1.1rem;
		font-size: 0.9rem;
	}

	.btn-yellow {
		background: var(--yellow);
		color: var(--blue-deep);
	}

	.btn-blue {
		background: var(--blue);
		color: #fff;
	}

	.btn-outline {
		border: 2px solid #fff;
		color: #fff;
	}

	/* Hero */
	.hero {
		position: relative;
		background:
			linear-gradient(180deg, rgba(10, 70, 133, 0.55) 0%, rgba(10, 70, 133, 0.72) 100%),
			url('/photos/volunteer-group.jpg') center 35% / cover no-repeat;
		color: #fff;
		text-align: center;
		padding: 7rem 0 8rem;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 800;
		color: var(--yellow);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-shadow: 0 2px 16px rgba(10, 40, 75, 0.5);
	}

	.tagline {
		font-family: 'Baloo 2', sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.5rem);
		letter-spacing: 0.35em;
		text-transform: uppercase;
		color: var(--sky);
		margin-top: 0.25rem;
	}

	.hero-text {
		max-width: 620px;
		margin: 1.5rem auto 2rem;
		font-size: 1.15rem;
		color: #eaf5fe;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.hero-wave {
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 60px;
	}

	/* Sections */
	.section {
		padding: 4.5rem 0;
	}

	.section-sky {
		background: #e8f4fd;
	}

	.section-blue {
		background: linear-gradient(160deg, var(--blue-dark), var(--blue-deep));
		color: #fff;
	}

	.section-blue h2 {
		color: var(--yellow);
	}

	.section-blue .lead {
		color: #dcedfb;
	}

	.eyebrow {
		font-family: 'Baloo 2', sans-serif;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		font-size: 0.85rem;
		color: var(--red);
		margin-bottom: 0.5rem;
	}

	.eyebrow.light {
		color: var(--yellow);
	}

	.section h2 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		margin-bottom: 1rem;
		color: var(--blue-deep);
	}

	.section-blue h2 {
		color: var(--yellow);
	}

	.lead {
		font-size: 1.15rem;
	}

	/* Cards */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.card {
		background: #fff;
		border-radius: 20px;
		padding: 2rem 1.75rem;
		box-shadow: 0 6px 24px rgba(10, 70, 133, 0.08);
		border-top: 5px solid var(--yellow);
	}

	.card h3 {
		font-size: 1.3rem;
		color: var(--blue-dark);
		margin-bottom: 0.5rem;
	}

	.card-icon {
		margin-bottom: 1rem;
		color: var(--blue);
	}

	.card-icon svg {
		width: 34px;
		height: 34px;
	}

	.section-intro {
		max-width: 62ch;
		font-size: 1.1rem;
	}

	.homes-note {
		margin-top: 2rem;
		text-align: center;
		font-size: 1.05rem;
	}

	/* Gallery */
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
		margin-top: 2rem;
	}

	.gallery img {
		width: 100%;
		height: 260px;
		object-fit: cover;
		border-radius: 16px;
		box-shadow: 0 6px 20px rgba(10, 70, 133, 0.12);
	}

	.miami-gallery img {
		height: 380px;
	}

	/* Footer */
	.site-footer {
		background: var(--blue-deep);
		color: #dcedfb;
		padding: 2.5rem 0;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		justify-content: space-between;
	}

	.footer-inner img {
		border-radius: 10px;
	}

	.footer-inner p {
		flex: 1;
		min-width: 220px;
	}

	.footer-inner a {
		color: var(--yellow);
		font-weight: 700;
		text-decoration: none;
	}

	/* Mobile */
	@media (max-width: 700px) {
		.nav {
			flex-direction: column;
			gap: 0.5rem;
			padding-block: 0.75rem;
		}

		.nav-links {
			justify-content: center;
			gap: 0.5rem 1rem;
		}

		.nav-links > a:not(.btn) {
			font-size: 0.9rem;
		}

		.hero {
			padding: 3rem 0 4.5rem;
		}

		.hero-text {
			font-size: 1.05rem;
		}

		.hero-actions {
			flex-direction: column;
			align-items: center;
		}

		.hero-actions .btn {
			width: min(280px, 100%);
			text-align: center;
		}

		.section {
			padding: 3rem 0;
		}

		.card {
			padding: 1.5rem 1.35rem;
		}

		.footer-inner {
			flex-direction: column;
			text-align: center;
			gap: 0.75rem;
		}
	}
</style>
