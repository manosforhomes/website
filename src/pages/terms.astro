---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Terms of Use — Manos for Homes"
	description="Terms of use for the Manos for Homes website."
>
	<Header />

	<main class="legal container">
		<p class="eyebrow">Legal</p>
		<h1>Terms of Use</h1>
		<p class="updated">Last updated: August 20, 2026</p>

		<p>
			Welcome to the Manos for Homes website. By using this site, you agree to these terms.
		</p>

		<h2>About us</h2>
		<p>
			Manos for Homes is a non-profit foundation serving communities in the United States and
			Colombia. This website exists to share our mission, our work, and ways to support it.
		</p>

		<h2>Use of this site</h2>
		<p>
			This site is provided for informational purposes. You agree not to misuse it — for example,
			by attempting to disrupt it or by using its content to mislead others.
		</p>

		<h2>Our content</h2>
		<p>
			The Manos for Homes name, logo, text, and photos on this site belong to Manos for Homes or
			are used with permission, and may not be used without our consent. Partner names and logos
			belong to their respective organizations.
		</p>

		<h2>Donations</h2>
		<p>
			Donations are processed by third-party platforms under their own terms. Manos for Homes has
			applied for recognition as a tax-exempt organization under Section 501(c)(3) of the Internal
			Revenue Code; that application is pending. If granted, tax-exempt status generally applies
			retroactively, but please consult your tax advisor about the deductibility of your
			contribution.
		</p>

		<h2>Third-party links</h2>
		<p>
			Links to other websites are provided for convenience. We are not responsible for the content
			or practices of third-party sites.
		</p>

		<h2>No warranties</h2>
		<p>
			This site is provided "as is." While we work to keep information accurate and current, we
			make no warranties about its completeness or availability.
		</p>

		<h2>Changes</h2>
		<p>
			We may update these terms from time to time; the date above reflects the latest revision.
		</p>

		<h2>Contact</h2>
		<p>
			Questions? Reach us on Instagram at <a href="https://www.instagram.com/project_manosforhomes/" target="_blank" rel="noopener">@project_manosforhomes</a>.
		</p>
	</main>

	<Footer />
</Layout>

<style>
	.container {
		width: min(760px, 92%);
		margin-inline: auto;
	}

	.legal {
		padding: 3.5rem 0 4.5rem;
	}

	.eyebrow {
		font-family: 'Baloo 2', sans-serif;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		font-size: 0.85rem;
		color: var(--red);
		margin: 0 0 0.5rem;
	}

	h1 {
		color: var(--blue-deep);
		font-size: clamp(1.9rem, 4vw, 2.5rem);
		margin: 0 0 0.25rem;
	}

	.updated {
		color: #5a7089;
		font-size: 0.9rem;
		margin: 0 0 2rem;
	}

	h2 {
		color: var(--blue-dark);
		font-size: 1.25rem;
		margin: 2rem 0 0.5rem;
	}

	p {
		margin: 0 0 1rem;
	}
</style>
